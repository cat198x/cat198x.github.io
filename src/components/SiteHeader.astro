---
import Plate from '@198x-ui/components/Plate.astro';

const nav = [
  { href: '/#why', label: 'Why' },
  { href: '/#how', label: 'How it works' },
  { href: '/#install', label: 'Install' },
  { href: 'https://github.com/cat198x', label: 'GitHub' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <Plate prefix="cat" project="cat" size={20} href="/" />
    <nav aria-label="Primary navigation">
      {nav.map((item) => (
        <>
          <a href={item.href}>{item.label}</a>{' '}
        </>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    overflow-x: auto;
  }

  nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: 6px;
    padding: 0 0.72rem;
    color: var(--ink-muted);
    font-size: 0.94rem;
    font-weight: 620;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      background: var(--accent-soft);
      color: var(--accent-strong);
    }
  }

  @media (max-width: 680px) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.2rem;
      padding-block: 0.55rem;
    }

    nav {
      width: 100%;
      padding-bottom: 0.1rem;
    }
  }
</style>
