---
import SiteFooter from '@components/SiteFooter.astro';
import SiteHeader from '@components/SiteHeader.astro';
// The kit first: global.css defines this site's own names in terms of these,
// so it has to see them already declared.
import '@198x-ui/tokens.css';
import '@198x-ui/fonts.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cat198x',
  description = 'Cat198x — catalogue, verify, and reorganise retro software and media collections safely: DAT-matched by content hash, with a plan you review before anything moves.',
} = Astro.props;

const pageTitle = title === 'Cat198x' ? title : `${title} - Cat198x`;
---

<!doctype html>
<!-- data-tint carries the project colour as an ambient ground, at the ceilings
     fixed in the kit's tokens.css. See family-visual-identity.md §3b. -->
<html lang="en" data-tint="cat">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
